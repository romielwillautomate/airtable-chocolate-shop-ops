# Every variable used anywhere in this repo. Copy to .env (never commit it) and put the values in your n8n
# environment, then restart n8n. Setup for each service: docs/setup.md. Automation 06 runs inside Airtable and
# needs none of these.
#
# The workflows read these with $env, so self-hosted n8n must allow it:
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# On n8n Cloud, $env is not available: replace $env. with $vars. in the workflow files and create the same names
# as Variables. Optional: the time zone of 04's monthly schedule (08:00 on the 20th).
# GENERIC_TIMEZONE=America/New_York

# ---- Airtable (01 to 05, and setup/create_base.py)
# airtable.com/create/tokens, access to the Demo Chocolate Co. base only. The automations need data.records:read
# and data.records:write; setup/create_base.py also needs schema.bases:read and schema.bases:write.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX.your-personal-access-token
# The base id from the base URL: https://airtable.com/appXXXXXXXXXXXXXX/...
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
# setup/create_base.py only, optional: another Airtable API host (the tests point it at the mock). Default:
# AIRTABLE_API_URL=https://api.airtable.com

# ---- Shopify
# 02, 03 and 05 call the Admin GraphQL API with this token. It must not expire: a custom app made in the Shopify
# admin before 2026-01-01, or a non-expiring offline token from the authorization code grant (docs/setup.md).
# Scopes: write_inventory and read_locations (02), write_draft_orders and read_customers (03, 05), read_orders (05).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_your-admin-api-access-token
# Optional, default 2026-10. 02 needs 2026-04 or newer.
SHOPIFY_API_VERSION=2026-10
# 01: the key Shopify signs the order webhooks with (X-Shopify-Hmac-Sha256). For webhooks made in
# Settings > Notifications > Webhooks it is shown on that page; for app webhooks it is the app's client secret.
SHOPIFY_WEBHOOK_SECRET=your-webhook-signing-key
# 02: the location whose stock the inventory sync sets (Settings > Locations, the number at the end of the URL)
SHOPIFY_LOCATION_ID=gid://shopify/Location/0000000000

# ---- Claude (03, 05)
# console.anthropic.com > API keys
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional, default claude-sonnet-5. 03 and 05 use a forced tool call, which claude-opus-5-5 and claude-fable-5-1
# refuse with a 400, so on those models every message would go to the fallback and to a person.
# claude-haiku-4-5 also works and costs less.
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Postmark (03, 05)
# Servers > your server > API Tokens (the Server API token). The From addresses must be confirmed sender signatures.
POSTMARK_SERVER_TOKEN=your-postmark-server-token
# Optional, default outbound (the server's default transactional stream)
POSTMARK_MESSAGE_STREAM=outbound
EMAIL_FROM_WHOLESALE=Demo Chocolate Wholesale <wholesale@example.com>
EMAIL_FROM_SUPPORT=Demo Chocolate Support <support@example.com>

# ---- Slack incoming webhooks
# Ops channel: error alerts from shared/error-alert-slack.json (every automation), new SKU alerts (01), the
# inventory note (02), quote reviews and run summaries (03, required there).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Packing team: cold pack alerts (01, falls back to SLACK_WEBHOOK_URL) and the monthly box summary (04, required)
SLACK_PACKING_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Support team: tickets that need a person (05). Use a private channel, the alerts carry names and emails.
SLACK_SUPPORT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---- Shared secrets for the webhooks you call yourself. Make up long random strings.
# Header X-Run-Now-Secret on the Run Now webhooks of 02, 03 and 04. Without it, Run Now always answers 401.
RUN_NOW_SECRET=make-up-a-long-random-string
# 03: header X-Form-Secret, sent by your website's server with each wholesale form post
WHOLESALE_FORM_SECRET=make-up-another-long-random-string
# 05: header X-Support-Secret, added server side by the help form or email parser
SUPPORT_FORM_SECRET=make-up-a-third-long-random-string

# ---- Business rules (all optional, these are the defaults)
# 01 and 05: a cold pack is needed when any day of the forecast reaches this many degrees Celsius
MELT_TEMP_C=27
# 01: days of forecast to check, today included, 1 to 16
MELT_FORECAST_DAYS=3
# 02, 03 and 04: batches with this many days or fewer before best before are not sold any more
SELL_BY_BUFFER_DAYS=14
# 02: batches whose best before is within this many days get a promo (0 switches promos off), at this discount
PROMO_WINDOW_DAYS=45
PROMO_DISCOUNT_PERCENT=25
# 03: how long a quote stays valid
QUOTE_VALID_DAYS=14
# 04: a bar is not repeated within this many past boxes (0 to 12)
REPEAT_WINDOW=1
# 05: claims are handled automatically this many days after delivery; a customer who already has CLAIM_LIMIT
# approved replacements goes to a person
CLAIM_WINDOW_DAYS=7
CLAIM_LIMIT=2

# ---- Tests only (tests/mocks and automations/*/tests). Never needed in production.
N8N_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key
# Instead of N8N_API_KEY: a .env file that has it. With Windows Python from Git Bash, write C:/Users/..., not /c/Users/...
# N8N_ENV_FILE=C:/path/to/n8n/.env
# How n8n reaches the mock servers: host.docker.internal when n8n runs in Docker, 127.0.0.1 otherwise
MOCK_HOST=host.docker.internal
# Optional: the port of the mock unit tests (default 8790)
# MOCK_TEST_PORT=8790
# Optional: files where the 03 and 05 tests save the emails, alerts and requests of a run, for their test reports
# SAMPLES_FILE=samples-03.json
# E2E_SAMPLES=samples-05.json
# Set by 06's mutation-check.mjs for its own runs against broken copies of the scripts; you never set it yourself.
# SCRIPTS_DIR=
# Optional: 05 also sends its captured Claude request to Anthropic's free count_tokens endpoint when a key is set
# (from the environment or N8N_ENV_FILE). It never calls /v1/messages.
# ANTHROPIC_API_KEY=your-anthropic-api-key
